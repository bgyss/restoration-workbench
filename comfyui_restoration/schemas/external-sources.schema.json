{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Restoration Benchmark Sources",
  "type": "object",
  "required": ["schema_version", "corpus", "download_policy", "sources"],
  "properties": {
    "schema_version": {"const": "1"},
    "corpus": {"const": "external-source-manifest"},
    "download_policy": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "title", "source_url", "rights_url", "rights_statement", "license", "redistribution", "failure_modes", "sha256", "download_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "rights_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "rights_statement": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "redistribution": {"type": "string", "minLength": 1},
          "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
          "download_status": {"enum": ["not_fetched", "fetched_unverified", "fetched_verified"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
